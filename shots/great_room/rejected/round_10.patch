+// distressed low-pile vintage rug: faded blue-grey field with soft medallion, darker blurred border, wear
+function rugTexV2() {
+  return canvasTex(1024, 1368, (g, w, h) => {
+    const R = rng(55);
+    g.fillStyle = '#8f8d88'; g.fillRect(0, 0, w, h);
