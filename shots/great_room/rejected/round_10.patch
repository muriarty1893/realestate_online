+      const gr = g.createRadialGradient(x, y, 0, x, y, r); gr.addColorStop(0, c + a); gr.addColorStop(1, c + '00'); g.fillStyle = gr; g.beginPath(); g.ellipse(x, y, r * (1 + R()), r, R() * 3, 0, 7); g.fill(); } };
+    blob(120, 90, 260, ['#a7a8a8', '#7d8794', '#b9b3a6', '#6c7683', '#9a9690'], '99');
+    g.save(); g.filter = 'blur(9px)';
+    // central medallion + corner spandrels (soft, faded)
+    g.strokeStyle = 'rgba(64,78,96,0.55)'; g.lineWidth = 16;
+    for (const [rx, ry, a] of [[300, 440, 0.55], [220, 330, 0.5], [130, 200, 0.45]]) { g.globalAlpha = a + 0.2; g.beginPath(); g.ellipse(w / 2, h / 2, rx, ry, 0, 0, 7); g.stroke(); }
+    g.globalAlpha = 0.4; g.fillStyle = '#566678'; g.beginPath(); g.ellipse(w / 2, h / 2, 110, 170, 0, 0, 7); g.fill();
+    g.fillStyle = '#c9c1b0'; g.globalAlpha = 0.35; g.beginPath(); g.ellipse(w / 2, h / 2, 60, 100, 0, 0, 7); g.fill();
+    for (const [cx, cy] of [[190, 250], [w - 190, 250], [190, h - 250], [w - 190, h - 250]]) { g.globalAlpha = 0.35; g.fillStyle = '#5d6d80'; g.beginPath(); g.moveTo(cx, cy - 120); g.lineTo(cx + 90, cy); g.lineTo(cx, cy + 120); g.lineTo(cx - 90, cy); g.fill(); }
+    // border: darker band, pale guard stripe, outer band, all blurred and uneven
+    g.globalAlpha = 0.7; g.fillStyle = '#4f5d6e';
+    const bw = 95; g.fillRect(0, 0, w, bw); g.fillRect(0, h - bw, w, bw); g.fillRect(0, 0, bw, h); g.fillRect(w - bw, 0, bw, h);
+    g.globalAlpha = 0.5; g.strokeStyle = '#cfc8b8'; g.lineWidth = 14; g.strokeRect(bw + 14, bw + 14, w - 2 * bw - 28, h - 2 * bw - 28);
+    g.globalAlpha = 0.35; g.fillStyle = '#7b6f66'; for (let t = 0; t < 30; t++) { const x = bw + 30 + R() * (w - 2 * bw - 60); g.fillRect(x, 20 + R() * 20, 30 + R() * 40, 30); g.fillRect(x, h - 50 - R() * 20, 30 + R() * 40, 30); }
